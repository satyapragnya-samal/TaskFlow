    # Flask Secret Key (used for session signing and CSRF protection)
SECRET_KEY=change_this_to_a_secure_random_hex_key

# MySQL Connection URI format:
# mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/taskflow_db

# Flask Environment mode
FLASK_ENV=development
FLASK_DEBUG=1